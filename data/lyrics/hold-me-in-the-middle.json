  "lines": [
    {
      "text": "I saw a stranger’s hands today",
      "section": "Verse 1",
      "t": 10.31
    },
    {
      "text": "And something in me slipped away",
      "section": "Verse 1",
      "t": 15.76
    },
    {
      "text": "Suddenly I’m five years old again",
      "section": "Verse 1",
      "t": 21.54
    },
    {
      "text": "Swinging hard between the two of them",
      "section": "Verse 1",
      "t": 26.89
    },
    {
      "text": "They’d lift me like the world was light",
      "section": "Pre-Chorus",
      "t": 32.99
    },
    {
